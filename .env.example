# PostgreSQL Database Connection (Required in production)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Authentication Security Configs (Strictly required in production)
JWT_SECRET=your_super_secret_jwt_key_here_64_chars_min
ADMIN_EMAIL=akpereraphael@gmail.com
# Bcrypt hash of your admin password (generate via bcrypt with 10+ salt rounds)
ADMIN_PASSWORD_HASH=$2b$10$YourGeneratedBcryptPasswordHashHere

# Email Integration via Resend (Required for inquiry forwarding)
RESEND_API_KEY=re_your_resend_api_key_here

